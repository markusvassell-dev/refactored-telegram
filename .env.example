# Element Engagements — environment contract.
#
# Copy to .env for local development. Never commit a real value.
# The application validates this at startup and refuses to boot on a
# misconfiguration; see packages/shared/src/env.ts for the schema.
#
# IMPORTANT: the Karbon and Adobe Acrobat Sign variable names below reflect
# what this application reads. They are NOT guaranteed to match the exact
# credential names those vendors currently issue. Confirm the current official
# requirements against each vendor's documentation and adjust the Integrations
# configuration accordingly before production use.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Displayed product name. Change this to rename the product; no code depends
# on the value.
APP_NAME=Element Engagements

APP_BASE_URL=http://localhost:3000

# development | test | staging | production
APP_ENV=development

# Test Mode. Defaults to true so a misconfigured deployment fails safe.
# When on: no real client is emailed, no production Adobe Sign agreement is
# created, nothing is written to a production Karbon work item, and every
# generated file is prefixed with TEST.
# This is a floor: the database cannot turn it off while it is set here.
TEST_MODE=true

# Production sending must be armed explicitly, and only when TEST_MODE is off.
# An administrator must also enable it in Settings; both are required.
ALLOW_PRODUCTION_SENDING=false

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/element_engagements?schema=public

# 32 bytes, hex or base64. Generate with: openssl rand -hex 32
# Used for envelope encryption of stored integration credentials.
ENCRYPTION_KEY=

# 32 bytes, hex or base64. Generate with: openssl rand -hex 32
# Seals the session cookie and signs temporary document download links.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Staff notification e-mail, through the firm's own Microsoft 365
# ---------------------------------------------------------------------------
#
# Off by default. Sends through the Entra ID app registration below, so it
# needs no new vendor — but it needs the `Mail.Send` APPLICATION permission,
# which is a different grant from the delegated sign-in scopes.
#
# That permission lets the app send as ANY mailbox in the tenant. Restrict it
# to the sender below with an Exchange application access policy; see
# docs/notifications.md for the exact commands.
#
# Staff only. Nothing in this application e-mails a client.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_SENDER=

# ---------------------------------------------------------------------------
# Microsoft Entra ID — the production authentication method
# ---------------------------------------------------------------------------
#
# All three come from one app registration in the Azure portal
# (Entra ID -> App registrations). The first two are on its Overview page and
# are both GUIDs; the third is created under Certificates & secrets, where the
# portal shows a "Value" and a "Secret ID" — it is the Value that goes here,
# and it is displayed once.
#
# The redirect URI below must be registered on the app registration exactly as
# it appears here, character for character.

# Directory (tenant) ID: a GUID, or a verified domain such as
# contoso.onmicrosoft.com. Outside development the app refuses to start if this
# is not one of those shapes — a placeholder here produces a healthy-looking
# deployment whose sign-in button sends people to Microsoft to be told
# AADSTS900023.
ENTRA_TENANT_ID=
# Application (client) ID: always a GUID.
ENTRA_CLIENT_ID=
# The secret's Value, not its Secret ID.
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/entra/callback

# Local development login. Honoured only when APP_ENV is development or test;
# the environment schema refuses to start with this enabled in staging or
# production.
DEV_LOGIN_ENABLED=true

# Comma-separated addresses granted ADMINISTRATOR when they sign in through
# Entra ID. Needed exactly once, on a first deployment: directory role mapping
# is empty until an administrator configures it, so without this the first
# person to sign in has no roles and no way to grant themselves any.
# The grant happens only after Entra ID authenticates the address, and it is
# audited. Clear it once real administrators exist.
BOOTSTRAP_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Karbon
# ---------------------------------------------------------------------------

# Vendor credentials are NOT environment variables. A Karbon bearer token and
# access key are entered on the Integrations screen, where they are encrypted
# with ENCRYPTION_KEY, carry a sandbox-or-production flag, and every change is
# audited. That flag is what Test Mode keys off; a credential supplied through
# the environment would have no flag, and Test Mode's guarantee that no
# production integration is reachable would become a convention rather than a
# structural property.

KARBON_API_BASE_URL=https://api.karbonhq.com/v3

# Shared secret used to verify inbound Karbon webhooks. This one is a value this
# application chooses and gives to Karbon, not a credential Karbon issues.
KARBON_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Adobe Acrobat Sign
# ---------------------------------------------------------------------------

# Region-specific, e.g. https://api.na1.adobesign.com
# As above: the client id, secret and refresh token are entered on the
# Integrations screen. Only the region-specific base URL and the webhook secret
# are environment configuration.
ADOBE_SIGN_API_BASE_URL=
ADOBE_SIGN_REDIRECT_URI=http://localhost:3000/api/integrations/adobe-sign/callback
ADOBE_SIGN_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI-assisted extraction — opt-in only
# ---------------------------------------------------------------------------

# When false (the default) no document text is ever sent to an AI provider.
AI_EXTRACTION_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# Values below this confidence are reported as missing so a person enters them.
AI_MIN_CONFIDENCE=0.8

# ---------------------------------------------------------------------------
# Documents
# ---------------------------------------------------------------------------

DOCUMENT_TEMP_DIRECTORY=/tmp/element-engagements
DOCUMENT_STORAGE_DIRECTORY=/var/lib/element-engagements/storage

# Working copies are purged after this many hours. Karbon holds the
# authoritative copy of every final and signed document.
DOCUMENT_RETENTION_HOURS=72
DOCUMENT_MAX_UPLOAD_BYTES=26214400

LIBREOFFICE_BINARY=soffice
PDF_CONVERSION_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Policy
# ---------------------------------------------------------------------------

# Fee increases above this percentage require partner approval. An
# administrator can change it in Settings without a redeploy.
HIGH_FEE_INCREASE_THRESHOLD_PERCENT=10

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEALTH_PORT=3001
